# Copy this file to .env and fill in your values.
# Get these from: https://supabase.com/dashboard/project/<your-project-ref>/settings/api
#
# SUPABASE_URL       — "Project URL" (e.g. https://xxxx.supabase.co)
# SUPABASE_ANON_KEY  — "anon public" key (also called "publishable key" in
#                      newer Supabase dashboards). This is SAFE to ship in
#                      the app because Row Level Security restricts what it
#                      can access.
#
# NEVER put the "service_role" / "secret" key in this file — that key
# bypasses RLS and must only be used server-side.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
